-- PostgreSQL Zoo Database Schema (CORRECTED FOR POSTGRESQL)
-- This file is designed to be run on an EMPTY database

-- Enable vector extension if available (optional)
-- CREATE EXTENSION IF NOT EXISTS vector;

-- Animals table (replaces museum_objects/artifacts)
CREATE TABLE IF NOT EXISTS animals (
    id SERIAL PRIMARY KEY,
    animal_id VARCHAR(50) UNIQUE NOT NULL,
    common_name VARCHAR(200) NOT NULL,
    scientific_name VARCHAR(200),
    distribution_range TEXT,
    habitat VARCHAR(200),
    classification JSONB,
    characteristics TEXT,
    body_length VARCHAR(100),
    weight VARCHAR(100),
    diet TEXT,
    lifespan VARCHAR(100),
    conservation_status VARCHAR(50),
    location_in_park VARCHAR(200),
    zone VARCHAR(100),
    description TEXT,
    fun_facts TEXT,
    threats TEXT,
    conservation_message TEXT,
    metadata JSONB,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Users table (children profiles)
CREATE TABLE IF NOT EXISTS users (
    id SERIAL PRIMARY KEY,
    user_id VARCHAR(50) UNIQUE NOT NULL,
    name VARCHAR(100),
    age_group VARCHAR(20),
    interests TEXT[],
    favorite_animals TEXT[],
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    last_active TIMESTAMP
);

-- Conversations table
CREATE TABLE IF NOT EXISTS conversations (
    id SERIAL PRIMARY KEY,
    user_id VARCHAR(50) REFERENCES users(user_id),
    session_id VARCHAR(100),
    message TEXT,
    response TEXT,
    detected_animal VARCHAR(100),
    context JSONB,
    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Learning progress table
CREATE TABLE IF NOT EXISTS learning_progress (
    id SERIAL PRIMARY KEY,
    user_id VARCHAR(50) REFERENCES users(user_id),
    animal_id VARCHAR(50) REFERENCES animals(animal_id),
    interaction_type VARCHAR(50),
    duration INTEGER,
    quiz_score FLOAT,
    achievements TEXT[],
    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Animal encounters table
CREATE TABLE IF NOT EXISTS animal_encounters (
    id SERIAL PRIMARY KEY,
    user_id VARCHAR(50) REFERENCES users(user_id),
    animal_id VARCHAR(50) REFERENCES animals(animal_id),
    encounter_type VARCHAR(50),
    location VARCHAR(100),
    duration INTEGER,
    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Beacon locations table
CREATE TABLE IF NOT EXISTS beacons (
    id SERIAL PRIMARY KEY,
    beacon_uuid VARCHAR(100),
    major INTEGER,
    minor INTEGER,
    x FLOAT,
    y FLOAT,
    z FLOAT,
    location_name VARCHAR(100),
    zone VARCHAR(100),
    floor INTEGER
);

-- User locations table
CREATE TABLE IF NOT EXISTS user_locations (
    id SERIAL PRIMARY KEY,
    user_id VARCHAR(50),
    x FLOAT,
    y FLOAT,
    z FLOAT,
    confidence FLOAT,
    zone VARCHAR(100),
    nearest_animal VARCHAR(100),
    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Create indexes
CREATE INDEX IF NOT EXISTS idx_animals_common_name ON animals(common_name);
CREATE INDEX IF NOT EXISTS idx_animals_scientific_name ON animals(scientific_name);
CREATE INDEX IF NOT EXISTS idx_animals_zone ON animals(zone);
CREATE INDEX IF NOT EXISTS idx_animals_animal_id ON animals(animal_id);

CREATE INDEX IF NOT EXISTS idx_conversations_user_id ON conversations(user_id);
CREATE INDEX IF NOT EXISTS idx_conversations_timestamp ON conversations(timestamp);
CREATE INDEX IF NOT EXISTS idx_conversations_detected_animal ON conversations(detected_animal);

CREATE INDEX IF NOT EXISTS idx_learning_progress_user_id ON learning_progress(user_id);
CREATE INDEX IF NOT EXISTS idx_learning_progress_animal_id ON learning_progress(animal_id);

CREATE INDEX IF NOT EXISTS idx_user_locations_user_id ON user_locations(user_id);
CREATE INDEX IF NOT EXISTS idx_user_locations_timestamp ON user_locations(timestamp);
CREATE INDEX IF NOT EXISTS idx_user_locations_zone ON user_locations(zone);

CREATE INDEX IF NOT EXISTS idx_encounters_user_id ON animal_encounters(user_id);
CREATE INDEX IF NOT EXISTS idx_encounters_animal_id ON animal_encounters(animal_id);
CREATE INDEX IF NOT EXISTS idx_encounters_timestamp ON animal_encounters(timestamp);

-- Create trigger function for updated_at
CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$$ language 'plpgsql';

-- Create trigger
CREATE TRIGGER update_animals_updated_at BEFORE UPDATE ON animals
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();