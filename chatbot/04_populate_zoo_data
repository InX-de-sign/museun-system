-- Create a view for easy animal browsing by zone
CREATE OR REPLACE VIEW animals_by_zone AS
SELECT 
    zone,
    common_name,
    scientific_name,
    location_in_park,
    conservation_status,
    animal_id
FROM animals
ORDER BY zone, common_name;

-- Create a view for conservation status summary
CREATE OR REPLACE VIEW conservation_summary AS
SELECT 
    conservation_status,
    COUNT(*) as animal_count,
    array_agg(common_name) as animals
FROM animals
WHERE conservation_status IS NOT NULL
GROUP BY conservation_status;